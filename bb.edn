{:paths ["src" "resources" "test"]
 :tasks
 {:requires ([babashka.fs :as fs])

  trace:gui {:doc "Browse a trace repo: bb trace:gui [repo] [port]  (central repo on :7360)"
             :requires ([trace.gui])
             :task (apply trace.gui/-main *command-line-args*)}

  trace:raw {:doc "Trace as text: bb trace:raw [project] [NN] [-v]"
             :requires ([trace.raw])
             :task (apply trace.raw/-main *command-line-args*)}

  trace:on {:doc "Record every Claude session into var/traces (the global hook; again after an update: it rewrites the hook lines)"
            :requires ([trace.install])
            :task (trace.install/on (str (fs/canonicalize (System/getProperty "babashka.config"))))}

  trace:off {:doc "Remove the global trace hook (the traces are kept)"
             :requires ([trace.install])
             :task (trace.install/off)}

  trace:replay {:doc "Old transcripts into a trace repo: bb trace:replay <sel> [--repo dir] [--map orig=dir]... [--force]  (default var/replay)"
                :requires ([trace.replay])
                :task (apply trace.replay/-main *command-line-args*)}

  trace:health {:doc "Is the trace working? bb trace:health [--ack]  (failing hook or worker, events not recorded yet, failed ones, sessions the hook never ran for; --ack: those were on purpose)"
                :requires ([trace.health])
                :task (if (= "--ack" (first *command-line-args*))
                        (doseq [{:keys [session file]} (trace.health/ack!)] (println "acked" session file))
                        (println (trace.health/line)))}

  trace:status {:doc "trace:health for a status bar: prints nothing while the trace is ok"
                :requires ([trace.health])
                :task (print (trace.health/short))}

  trace:drain {:doc "Record what the hook spooled, now, in this process (the worker does it by itself)"
               :requires ([trace.worker] [trace.git])
               :task (println (trace.worker/drain! trace.git/*repo*) "events recorded")}

  trace:own-objects {:doc "One-off for a trace repo of older code: repack, drop its alternates and seeded indexes (checked)"
                     :requires ([trace.worker] [trace.git])
                     :task (trace.worker/own-objects! trace.git/*repo*)}

  trace:retry {:doc "Spool the events the worker could not record again, and record them"
               :requires ([trace.worker] [trace.git])
               :task (let [r trace.git/*repo*] (println (trace.worker/retry! r) "spooled again;" (trace.worker/drain! r) "recorded"))}

  trace:fns {:doc "The fn layer (refs/fn/<project>/...): every Clojure definition's versions, parent 2 the trace commit; bb trace:fns [repo]  (the first run is the backfill, the worker keeps it up after)"
             :requires ([trace.fns])
             :task (apply trace.fns/-main *command-line-args*)}

  trace:probe {:doc "Was the transcript written when the hook fired? bb trace:probe [repo]"
               :requires ([trace.probe])
               :task (apply trace.probe/-main *command-line-args*)}

  trace:e2e {:doc "A real claude session in a fresh repo, recorded into a fresh trace repo, then checked (costs tokens)"
             :requires ([trace.e2e])
             :task (apply trace.e2e/-main *command-line-args*)}

  runs:go {:doc "Run the same prompts on several models/efforts and compare: bb runs:go --task N --prompts DIR|FILE [--start DIR] [--check CMD] --arm [name=]MODEL[:EFFORT] ... [--serial]"
           :requires ([trace.runner])
           :task (apply trace.runner/-main *command-line-args*)}

  runs:new {:doc "The same, asking for each thing (the wizard)"
            :requires ([trace.runner])
            :task (trace.runner/new-main)}

  runs:html {:doc "A comparison as one static HTML file: bb runs:html TASK [FILE]  (default var/reports/TASK.html)"
             :requires ([trace.runner])
             :task (apply trace.runner/html-main *command-line-args*)}

  copilot:install {:doc "Put reus into Copilot (its home, ~/.copilot or $COPILOT_HOME): the hooks that record every session, and /reus-compare"
                   :requires ([trace.copilot-install])
                   :task (trace.copilot-install/install!)}

  copilot:uninstall {:doc "Take reus out of Copilot's home again (the traces stay)"
                     :requires ([trace.copilot-install])
                     :task (trace.copilot-install/uninstall!)}

  copilot:catchup {:doc "Record Copilot sessions no hook recorded (IntelliJ or CLI), from Copilot's own log: [SESSION-ID | events.jsonl]..."
                   :requires ([trace.copilot-events])
                   :task (apply trace.copilot-events/-main *command-line-args*)}

  trace:test {:doc "Test the trace recorder"
              :requires ([clojure.test :as t] [trace.record-test])
              :task (let [{:keys [fail error]} (t/run-tests 'trace.record-test)]
                      (System/exit (if (zero? (+ fail error)) 0 1)))}

  test {:doc "Every test of this repo (the shell.js one needs node)"
        :requires ([clojure.test :as t] [trace.record-test] [trace.hook-test] [trace.replay-test] [trace.probe-test] [trace.store-test] [trace.turn-test] [trace.ignore-test] [trace.gui-test] [trace.call-test] [trace.fns-test] [trace.health-test] [trace.mirror-test] [trace.copilot-test] [trace.runs-test] [trace.runner-test] [jsonl.read-test])
        :task (let [{:keys [fail error]} (t/run-tests 'trace.record-test 'trace.hook-test 'trace.replay-test 'trace.probe-test 'trace.store-test 'trace.turn-test 'trace.ignore-test 'trace.gui-test 'trace.call-test 'trace.fns-test 'trace.health-test 'trace.mirror-test 'trace.copilot-test 'trace.runs-test 'trace.runner-test 'jsonl.read-test)
                    js (:exit (shell {:continue true} "node test/trace/shell_test.js"))]
                (System/exit (if (and (zero? (+ fail error)) (zero? js)) 0 1)))}

  jsonl:ls {:doc "Claude transcripts, one line each: bb jsonl:ls [sel] [--agents]  (sel: file, dir, session id, project)"
            :requires ([jsonl.stats]) :task (apply jsonl.stats/ls *command-line-args*)}
  jsonl:stats {:doc "Per session: prompts, tool calls, failures, tokens; totals"
               :requires ([jsonl.stats]) :task (apply jsonl.stats/stats *command-line-args*)}
  jsonl:calls {:doc "Every tool call as edn, one per line"
               :requires ([jsonl.stats]) :task (apply jsonl.stats/calls *command-line-args*)}
  jsonl:analyze {:doc "Tool calls by category: count, failures, time, output size [--each]"
                 :requires ([jsonl.analyze]) :task (apply jsonl.analyze/-main *command-line-args*)}
  jsonl:peek {:doc "What the sessions evaluated in a REPL"
              :requires ([jsonl.peek]) :task (apply jsonl.peek/-main *command-line-args*)}

  bench:round {:doc "Run the lame/sane bench: bb bench:round [from] [to]  (BENCH_RUN picks var/bench/<run>, default run2)"
               :requires ([bench.round]) :task (apply bench.round/-main *command-line-args*)}
  bench:gitstats {:doc "Commits by kind, most edited/read files, from the bench trace history"
                  :requires ([bench.gitstats]) :task (bench.gitstats/-main)}
  bench:parity {:doc "Same HTTP probes against both apps (:8081 sane, :8082 lame)"
                :requires ([bench.parity]) :task (bench.parity/-main)}
  bench:parity2 {:doc "Seeded paging/sort/search parity of both apps"
                 :requires ([bench.parity2]) :task (bench.parity2/-main)}}}
